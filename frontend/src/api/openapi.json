    "/api/auth/logout": {
      "post": {
        "description": "Always succeeds; signing out without a session is not an error.",
        "operationId": "logout_api_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
