      "get": {
        "operationId": "list_programmes_api_programmes_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProgrammeOut"
                  },
                  "title": "Response List Programmes Api Programmes Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
