{
  "components": {
    "schemas": {
      "AdminUser": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_active": {
            "title": "Is Active",
            "type": "boolean"
          },
          "is_guest": {
            "title": "Is Guest",
            "type": "boolean"
          },
          "last_login_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Login At"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "preferred_language": {
            "$ref": "#/components/schemas/Language"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "role",
          "preferred_language",
          "is_active",
          "is_guest",
          "created_at",
          "updated_at",
          "last_login_at"
        ],
        "title": "AdminUser",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "db": {
            "$ref": "#/components/schemas/ProbeStatus"
          },
          "ml": {
            "$ref": "#/components/schemas/ProbeStatus"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "db",
          "ml"
        ],
        "title": "Health",
        "type": "object"
      },
      "Language": {
        "enum": [
          "ar",
          "en"
        ],
        "title": "Language",
        "type": "string"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "maxLength": 320,
            "minLength": 1,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "Me": {
        "description": "Also the body of a successful login (POST /auth/login and /auth/guest).",
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_guest": {
            "title": "Is Guest",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "preferred_language": {
            "$ref": "#/components/schemas/Language"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "role",
          "preferred_language",
          "is_guest"
        ],
        "title": "Me",
        "type": "object"
      },
      "MeUpdate": {
        "additionalProperties": false,
        "properties": {
          "preferred_language": {
            "$ref": "#/components/schemas/Language"
          }
        },
        "required": [
          "preferred_language"
        ],
        "title": "MeUpdate",
        "type": "object"
      },
      "ProbeStatus": {
        "enum": [
          "ok",
          "down"
        ],
        "title": "ProbeStatus",
        "type": "string"
      },
      "ProgrammeOut": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name_ar": {
            "title": "Name Ar",
            "type": "string"
          },
          "name_en": {
            "title": "Name En",
            "type": "string"
          }
        },
        "required": [
          "id",
          "code",
          "name_ar",
          "name_en"
        ],
        "title": "ProgrammeOut",
        "type": "object"
      },
      "Role": {
        "enum": [
          "viewer",
          "editor",
          "admin"
        ],
        "title": "Role",
        "type": "string"
      },
      "UserCreate": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 320,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email",
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "title": "Password",
            "type": "string"
          },
          "preferred_language": {
            "$ref": "#/components/schemas/Language"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "name",
          "email",
          "password",
          "role",
          "preferred_language"
        ],
        "title": "UserCreate",
        "type": "object"
      },
      "UserUpdate": {
        "additionalProperties": false,
        "description": "Only the fields present are changed.",
        "properties": {
          "is_active": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Is Active"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "preferred_language": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Language"
              },
              {
                "type": "null"
              }
            ]
          },
          "role": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Role"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "UserUpdate",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Sanad API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/admin/users": {
      "get": {
        "operationId": "list_users_api_admin_users_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AdminUser"
                  },
                  "title": "Response List Users Api Admin Users Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Users",
        "tags": [
          "admin"
        ]
      },
      "post": {
        "operationId": "create_user_api_admin_users_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUser"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create User",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/admin/users/{user_id}": {
      "patch": {
        "operationId": "update_user_api_admin_users__user_id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "User Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUser"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Update User",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/auth/guest": {
      "post": {
        "operationId": "guest_login_api_auth_guest_post",
