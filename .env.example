# Sanad configuration. Copy to `.env` and adjust; never commit `.env`.
# Every setting has a working default, so `docker compose up` also runs without this file.

# --- Instance -------------------------------------------------------------------------------
# Compose project name and image tag. Change it only to run a second, separate stack on the
# same machine (the Makefile does this automatically inside git worktrees; see README).
# SANAD_INSTANCE=sanad

# --- Database (PostgreSQL 16 + pgvector) ---------------------------------------------------
# The db container is on the internal network only and is never published to the host.
# CHANGE POSTGRES_PASSWORD on any real deployment. Any characters are allowed (the app builds
# the connection URL itself); wrap the value in single quotes if it contains $, # or spaces.
# The password is applied when the database volume is first created; changing it later
# requires changing it inside Postgres too.
POSTGRES_USER=sanad
POSTGRES_PASSWORD=sanad
POSTGRES_DB=sanad
# Where api and worker reach Postgres. The defaults point at the bundled `db` service.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Web ------------------------------------------------------------------------------------
# Host port where staff open Sanad (http://<server>:8080). This is the only published port.
WEB_PORT=8080
# Digits in the Arabic interface: `latn` (Latin, 123; the default, the client's choice in Q6)
# or `arab` (Arabic-Indic, ١٢٣). English always uses Latin digits. Baked into the web image
# when it is built, so a change needs a rebuild (`make up` rebuilds).
AR_NUMBERING=latn
# Ask screen: above this server estimate (seconds) the screen says "this answer may take about
# S seconds" before the wait (SYSTEM_DESIGN §6). The web bundle reads it as
# VITE_ETA_NOTICE_SECONDS; compose does not pass it to the build yet, so 20 applies for now.
# ETA_NOTICE_SECONDS=20

# --- API and worker -------------------------------------------------------------------------
# Base URL of the embeddings/rerank service as seen from api and worker (the bundled `ml`).
ML_BASE_URL=http://ml:8001
# Python log level for api and worker: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
# Seconds /api/health waits for each dependency (db, ml) before reporting it "down".
HEALTH_TIMEOUT_SECONDS=2.0
# Seconds the ingestion worker waits between queue checks when idle. Uploads and retries
# wake it at once (Postgres LISTEN/NOTIFY); this is only the fallback poll.
WORKER_IDLE_SECONDS=30

# --- Accounts and sessions (B2) -------------------------------------------------------------
# Demo accounts created by the `init` service on first start (it never overwrites an existing
# account, so changing these later has no effect on accounts that already exist):
#   admin@sanad.example / DEMO_ADMIN_PASSWORD     editor@sanad.example / DEMO_EDITOR_PASSWORD
#   viewer@sanad.example / DEMO_VIEWER_PASSWORD   guest: the "Continue as guest" button (no password)
# These are public demo passwords. On any real deployment, change them before the first start,
# or create real accounts and deactivate the demo ones (Admin -> Users).
DEMO_ADMIN_PASSWORD=admin-demo-2026
DEMO_EDITOR_PASSWORD=editor-demo-2026
DEMO_VIEWER_PASSWORD=viewer-demo-2026
# Guest access: `seed_only` (the guest reads the synthetic seed documents only) or `off`
# (guest login refused and existing guest sessions ended).
GUEST_MODE=seed_only
# A session ends after this many minutes without a request...
SESSION_IDLE_MINUTES=480
# ...and after this many hours in any case.
SESSION_ABSOLUTE_HOURS=168
# Send the session cookie over HTTPS only. Set to true whenever Sanad is served over HTTPS;
# false is needed for plain http://localhost.
SESSION_COOKIE_SECURE=false
# Login rate limit: failed attempts allowed per window, per email and per client IP. Once over,
# every attempt (even with the right password) is refused until the window has passed.
LOGIN_WINDOW_SECONDS=900
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_MAX_FAILURES_PER_IP=20
# Minimum length of passwords set through Admin -> Users.
PASSWORD_MIN_LENGTH=10
# Where the init service finds seed/manifest.json (mounted there by docker-compose.yml).
SEED_DIR=/app/seed

# --- Documents and ingestion (B3) -----------------------------------------------------------
# Where uploaded files and their PDF renditions are kept: the `files` volume, shared by api,
# worker and init. Back this volume up together with the database.
FILES_DIR=/data/files
# Largest accepted upload, in bytes (50 MiB).
UPLOAD_MAX_BYTES=52428800
# Chunking (DECISIONS D1), in tokens of the bge-m3 tokenizer: target size, hard maximum,
# overlap between consecutive chunks of a page, and the size under which a page's last
# piece merges into the previous chunk. Changing these needs a re-index to take effect.
CHUNK_TARGET_TOKENS=350
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=50
CHUNK_MIN_TAIL_TOKENS=80
# Scanned documents fail with NO_TEXT_LAYER: a page with fewer than INGEST_MIN_PAGE_CHARS
# characters of text but an image is a scanned page, and a document fails when more than
# INGEST_SCANNED_PAGE_SHARE (0..1) of its pages are scanned. OCR is out of scope.
INGEST_MIN_PAGE_CHARS=20
INGEST_SCANNED_PAGE_SHARE=0.5
# Text extraction from PDFs: `poppler` (pdftotext; default, robust on Arabic across fonts) or
# `pdfium` (pypdfium2, with paragraph breaks rebuilt from line geometry). Changing it needs a
# re-index of existing documents.
PDF_EXTRACTOR=poppler
# Seconds LibreOffice may take to convert one DOCX or TXT file before CONVERSION_FAILED.
LIBREOFFICE_TIMEOUT_SECONDS=180
# A document whose processing stage hasn't moved for this many seconds is stale (its worker
# died) and goes back to the queue; after WORKER_MAX_ATTEMPTS tries it fails with
# WORKER_TIMEOUT.
WORKER_STALE_SECONDS=900
WORKER_MAX_ATTEMPTS=3
# Chunks per /embed request from the worker, and how long one ml request may take.
EMBED_BATCH_SIZE=8
ML_TIMEOUT_SECONDS=300

# --- ml service (bge-m3 embeddings, bge-reranker-v2-m3 rerank; int8 ONNX on CPU) -------------
# Inference threads. 4 measured fastest on a 10-CPU laptop VM (more threads contend) and
# leaves cores for the LLM; try more on a dedicated server. 0 lets onnxruntime decide.
ML_THREADS=4
# Texts per inference run. Keep 1: activations are quantised per run, so batching makes a
# text's vector or score depend on the texts batched with it, and on CPU it is also slower.
# Measured with 30 rerank candidates of ~300 tokens: 7.7 s at 1, 10.3 s at 4, 18.5 s at 8,
# with scores moving by up to 0.155 against single runs.
ML_BATCH_SIZE=1
# Inference runs allowed at once (each one uses every thread and its own working memory).
ML_MAX_CONCURRENCY=1
# Longest input in tokens; longer text is truncated. Chunks are at most 512 tokens.
ML_EMBED_MAX_TOKENS=1024
ML_RERANK_MAX_TOKENS=1024
# 1 keeps onnxruntime's memory arena (slightly faster, holds peak memory between requests).
ML_MEM_ARENA=0

# --- Development only (docker-compose.dev.yml) ----------------------------------------------
# Host-native Ollama, reachable from api/backend-dev only when the dev override is used.
# OLLAMA_BASE_URL=http://host.docker.internal:11434
