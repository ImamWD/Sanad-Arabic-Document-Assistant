# Sanad configuration. Copy to `.env` and adjust; never commit `.env`.
# Every setting has a working default, so `docker compose up` also runs without this file.

# --- Instance -------------------------------------------------------------------------------
# Compose project name and image tag. Change it only to run a second, separate stack on the
# same machine (the Makefile does this automatically inside git worktrees; see README).
# SANAD_INSTANCE=sanad

# --- Database (PostgreSQL 16 + pgvector) ---------------------------------------------------
# The db container is on the internal network only and is never published to the host.
# CHANGE POSTGRES_PASSWORD on any real deployment. Any characters are allowed (the app builds
# the connection URL itself); wrap the value in single quotes if it contains $, # or spaces.
# The password is applied when the database volume is first created; changing it later
# requires changing it inside Postgres too.
POSTGRES_USER=sanad
POSTGRES_PASSWORD=sanad
POSTGRES_DB=sanad
# Where api and worker reach Postgres. The defaults point at the bundled `db` service.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Web ------------------------------------------------------------------------------------
# Host port where staff open Sanad (http://<server>:8080). This is the only published port.
WEB_PORT=8080

# --- API and worker -------------------------------------------------------------------------
# Base URL of the embeddings/rerank service as seen from api and worker (the bundled `ml`).
ML_BASE_URL=http://ml:8001
# Python log level for api and worker: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
# Seconds /api/health waits for each dependency (db, ml) before reporting it "down".
HEALTH_TIMEOUT_SECONDS=2.0
# Seconds between idle wake-ups of the worker loop (M0 placeholder until ingestion lands).
WORKER_IDLE_SECONDS=30

# --- Accounts and sessions (B2) -------------------------------------------------------------
# Demo accounts created by the `init` service on first start (it never overwrites an existing
# account, so changing these later has no effect on accounts that already exist):
#   admin@sanad.example / DEMO_ADMIN_PASSWORD     editor@sanad.example / DEMO_EDITOR_PASSWORD
#   viewer@sanad.example / DEMO_VIEWER_PASSWORD   guest: the "Continue as guest" button (no password)
# These are public demo passwords. On any real deployment, change them before the first start,
# or create real accounts and deactivate the demo ones (Admin -> Users).
DEMO_ADMIN_PASSWORD=admin-demo-2026
DEMO_EDITOR_PASSWORD=editor-demo-2026
DEMO_VIEWER_PASSWORD=viewer-demo-2026
# Guest access: `seed_only` (the guest reads the synthetic seed documents only) or `off`
# (guest login refused and existing guest sessions ended).
GUEST_MODE=seed_only
# A session ends after this many minutes without a request...
SESSION_IDLE_MINUTES=480
# ...and after this many hours in any case.
SESSION_ABSOLUTE_HOURS=168
# Send the session cookie over HTTPS only. Set to true whenever Sanad is served over HTTPS;
# false is needed for plain http://localhost.
SESSION_COOKIE_SECURE=false
# Login rate limit: failed attempts allowed per window, per email and per client IP. Once over,
# every attempt (even with the right password) is refused until the window has passed.
LOGIN_WINDOW_SECONDS=900
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_MAX_FAILURES_PER_IP=20
# Minimum length of passwords set through Admin -> Users.
PASSWORD_MIN_LENGTH=10
# Where the init service finds seed/manifest.json (mounted there by docker-compose.yml).
SEED_DIR=/app/seed

# --- Development only (docker-compose.dev.yml) ----------------------------------------------
# Host-native Ollama, reachable from api/backend-dev only when the dev override is used.
# OLLAMA_BASE_URL=http://host.docker.internal:11434
