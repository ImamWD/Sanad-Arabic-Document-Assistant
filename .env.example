# Sanad configuration. Copy to `.env` and adjust; never commit `.env`.
# Every setting has a working default, so `docker compose up` also runs without this file.

# --- Database (PostgreSQL 16 + pgvector) ---------------------------------------------------
# The db container is on the internal network only and is never published to the host.
# CHANGE POSTGRES_PASSWORD on any real deployment.
POSTGRES_USER=sanad
POSTGRES_PASSWORD=sanad
POSTGRES_DB=sanad
# api and worker get DATABASE_URL built from the three values above (see docker-compose.yml).

# --- Web ------------------------------------------------------------------------------------
# Host port where staff open Sanad (http://<server>:8080). This is the only published port.
WEB_PORT=8080

# --- API and worker -------------------------------------------------------------------------
# Python log level for api and worker: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
# Seconds /api/health waits for each dependency (db, ml) before reporting it "down".
HEALTH_TIMEOUT_SECONDS=2.0
# Seconds between idle wake-ups of the worker loop (M0 placeholder until ingestion lands).
WORKER_IDLE_SECONDS=30
